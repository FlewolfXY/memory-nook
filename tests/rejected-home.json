{"records":[{"id":"story-sunset","title":"搬家那天，先把杯子拿出来","note":"箱子还没拆完，就先找出了那只绿杯子。蓝条纹抱枕垫在地上，坐着吃了半个饭团。窗户比上一个住处大一点。","date":"2026-09-03","image":"/assets/memories/moving-day.jpg","palette":["#9a8164","#5a3d24","#fce1a1"],"form":"box","spot":"side","rotation":0,"scale":1,"parents":[],"example":true,"paletteMethod":"sampled","resident":"阿禾","personalEdition":1,"generatedImage":true,"position":[2.25,0.04,1.6]},{"id":"story-sea","title":"夹着车票的那本书","note":"从旧住处到公司的路，要坐四十分钟地铁。那张薄薄的车票夹在第八十六页，后来换了路线，书签一直没换。","date":"2026-08-17","image":null,"palette":["#93a8ad","#d9c8aa","#7c9a82"],"form":"card","spot":null,"rotation":0,"scale":1,"parents":[],"example":true,"paletteMethod":"authored","resident":"阿禾","personalEdition":1},{"id":"story-forest","title":"这次终于读到了下一页","note":"搬完家四天，才重新打开这本书。抱枕还是旧的，窗外的树却不一样了。那张绿色书签往后挪了两页。","date":"2026-09-07","image":"/assets/memories/reading-window.jpg","palette":["#e6d7c0","#82827f","#26251e"],"form":"card","spot":null,"rotation":0,"scale":1,"parents":[],"example":true,"paletteMethod":"sampled","resident":"阿禾","personalEdition":1,"generatedImage":true},{"id":"story-autumn","title":"妈妈口述的番茄面","note":"电话开着免提，妈妈说先把番茄炒软。我在笔记本上记了三行，最后加了一句：盐要分两次放。","date":"2026-05-12","image":null,"palette":["#a8b994","#829ca6","#dbb69c"],"form":"card","spot":null,"rotation":0,"scale":1,"parents":[],"example":true,"paletteMethod":"authored","resident":"阿禾","personalEdition":1},{"id":"story-flowers","title":"小满第一次来新家","note":"桌子刚好能放下两碗面。小满说这回窗边终于有地方坐了。吃完谁也没立刻起身，我把这张照片挂在最容易看见的位置。","date":"2026-09-06","image":"/assets/memories/shared-meal.jpg","palette":["#5e3c21","#9d643a","#dd9c60"],"form":"card","spot":null,"rotation":0,"scale":1,"parents":[],"example":true,"paletteMethod":"sampled","resident":"阿禾","personalEdition":1,"generatedImage":true},{"id":"story-coffee","title":"缺了一点口，还是这只","note":"洗杯子时碰掉了边缘一点点釉。小满说换个新的吧。可这是第一次领工资时买的，握起来的手感我已经记住了。","date":"2026-03-22","image":null,"palette":["#b6c59f","#8ca8b1","#e4c692"],"form":"card","spot":null,"rotation":0,"scale":1,"parents":[],"example":true,"paletteMethod":"authored","resident":"阿禾","personalEdition":1},{"id":"story-snow","title":"冬天写到一半的信","note":"给小满写的信，写着写着变成了这一年的流水账。没有寄出去，夹进了本子里。下次见面，也许可以当面念。","date":"2026-01-18","image":null,"palette":["#a8b994","#829ca6","#dbb69c"],"form":"card","spot":null,"rotation":0,"scale":1,"parents":[],"example":true,"paletteMethod":"authored","resident":"阿禾","personalEdition":1},{"id":"story-city","title":"新地址写在最后一页","note":"上一个地址划掉了，新的写在下面。这个本子跟我搬过两次家。钥匙的样子变了，封皮上的折痕还在。","date":"2026-09-04","image":null,"palette":["#93a8ad","#d9c8aa","#7c9a82"],"form":"card","spot":null,"rotation":0,"scale":1,"parents":[],"example":true,"paletteMethod":"authored","resident":"阿禾","personalEdition":1},{"id":"story-picnic","title":"旧窗边带来的条纹","note":"搬家公司问这只抱枕要不要单独装袋。我说不用，抱着就行。到新屋时，第一件放好的东西就是它。","date":"2026-09-03","image":null,"palette":["#b6c59f","#8ca8b1","#e4c692"],"form":"card","spot":null,"rotation":0,"scale":1,"parents":[],"example":true,"paletteMethod":"authored","resident":"阿禾","personalEdition":1},{"id":"story-lavender","title":"留给来串门的人","note":"又买了一只小抱枕。平时搭在窗边，有人来的时候，就不用一直坐硬凳子了。小满来的前一天，我把它晒了一下午。","date":"2026-09-05","image":null,"palette":["#a8b994","#829ca6","#dbb69c"],"form":"card","spot":null,"rotation":0,"scale":1,"parents":[],"example":true,"paletteMethod":"authored","resident":"阿禾","personalEdition":1},{"id":"story-peach","title":"缝歪的那一小块","note":"抱枕边角开线了，用剩下的蓝布补了一块。针脚不齐，还扎了手。现在每次摸到这里，就知道哪一面朝上。","date":"2025-12-09","image":null,"palette":["#93a8ad","#d9c8aa","#7c9a82"],"form":"card","spot":null,"rotation":0,"scale":1,"parents":[],"example":true,"paletteMethod":"authored","resident":"阿禾","personalEdition":1},{"id":"story-rain","title":"雨天就在这里待着","note":"那天取消了出门的计划，抱着这个垫子听雨。后来搬家，把沙发让给了下一位租客，这只垫子带走了。","date":"2026-08-15","image":null,"palette":["#b6c59f","#8ca8b1","#e4c692"],"form":"card","spot":null,"rotation":0,"scale":1,"parents":[],"example":true,"paletteMethod":"authored","resident":"阿禾","personalEdition":1},{"id":"home-tote","title":"门边总是这个帆布袋","date":"2026-09-04","note":"钥匙、折叠伞和楼下超市的收据。袋子没有固定用途，反正出门时顺手一拎就走。搬家那天，绿杯子也是放在这里带过来的。","form":"tote","spot":"side","position":[2.9,0.04,0.35],"palette":["#e5d2ad","#8fa88b","#ba8a72"],"rotation":0,"scale":1,"parents":[],"example":true,"resident":"阿禾","personalEdition":1,"paletteMethod":"authored","image":null},{"id":"home-rabbit","title":"行李箱里给它留一点地方","date":"2026-09-03","note":"耳朵有一边总是垂着，是很多年前小满送的。搬家前说要少带点东西，最后还是给它留了一个角落。先让它坐在窗边吧。","form":"rabbit","spot":"window","position":[-1.68,0.79,-2.43],"palette":["#d8c4ac","#b7a2bf","#a4b496"],"rotation":0,"scale":1,"parents":[],"example":true,"resident":"阿禾","personalEdition":1,"paletteMethod":"authored","image":null},{"id":"home-lamp","title":"睡前只留这一盏","date":"2026-09-04","note":"顶灯太亮了。搬进来第二晚，把旧落地灯接好，晚上读书就只开它。屋子终于有了一小块熟悉的光。","form":"card","spot":null,"rotation":0,"scale":1,"parents":[],"palette":["#a8b994","#c9ab88","#dcc9ad"],"image":null,"example":true,"personalEdition":1,"resident":"阿禾","paletteMethod":"authored"},{"id":"home-plant","title":"从小满家剪来的一枝","date":"2026-04-21","note":"小满说插在水里就能活，我将信将疑地拿回来了。后来真的长了根。搬家时专门用纸包住花盆，生怕把新叶碰坏。","form":"card","spot":null,"rotation":0,"scale":1,"parents":[],"palette":["#a8b994","#c9ab88","#dcc9ad"],"image":null,"example":true,"personalEdition":1,"resident":"阿禾","paletteMethod":"authored"},{"id":"home-sofa","title":"终于能把腿蜷起来","date":"2026-09-02","note":"二手转来的小沙发，比原来想买的小一点。和小满抬上来时在楼梯口歇了两次。现在觉得，小一点也刚刚好。","form":"card","spot":null,"rotation":0,"scale":1,"parents":[],"palette":["#a8b994","#c9ab88","#dcc9ad"],"image":null,"example":true,"personalEdition":1,"resident":"阿禾","paletteMethod":"authored"},{"id":"home-shelf","title":"留了一层空位","date":"2026-09-05","note":"把几本旧书按读过的顺序放好。下面那层先空着，不急着买东西填满。也许以后会有想带回家的东西。","form":"card","spot":null,"rotation":0,"scale":1,"parents":[],"palette":["#a8b994","#c9ab88","#dcc9ad"],"image":null,"example":true,"personalEdition":1,"resident":"阿禾","paletteMethod":"authored"},{"id":"home-rug","title":"冬天赤脚也不凉","date":"2025-11-28","note":"买的时候量错了尺寸，多出来一小截。后来搬到这里，反而正好铺在茶几下面。","form":"card","spot":null,"rotation":0,"scale":1,"parents":[],"palette":["#a8b994","#c9ab88","#dcc9ad"],"image":null,"example":true,"personalEdition":1,"resident":"阿禾","paletteMethod":"authored"},{"id":"home-table","title":"两碗面刚好放得下","date":"2026-09-06","note":"桌面上有一小圈旧杯印，擦不掉。小满说不用管，等我们在这里吃过几顿饭，它就不算别人的旧桌子了。","form":"card","spot":null,"rotation":0,"scale":1,"parents":[],"palette":["#a8b994","#c9ab88","#dcc9ad"],"image":null,"example":true,"personalEdition":1,"resident":"阿禾","paletteMethod":"authored"}],"layout":{},"bindings":{"living-room/book-04":"story-sea","living-room/book-12":"story-autumn","living-room/book-18":"story-snow","living-room/book-22":"story-city","living-room/window-cushion-left":"story-picnic","living-room/window-cushion-right":"story-lavender","living-room/sofa-cushion-left":"story-peach","living-room/sofa-cushion-right":"story-rain","living-room/wall-frame-1":"story-flowers","living-room/cup":"story-coffee","living-room/table-books":"story-forest","living-room/floor-lamp":"home-lamp","living-room/shelf-plant":"home-plant","living-room/sofa":"home-sofa","living-room/bookcase":"home-shelf","living-room/rug":"home-rug","living-room/coffee-table":"home-table"},"edition":2,"gardenVersion":2}